{
  "name": "@koios-news/independent-editorial-assessment",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Separately hireable independent editorial assessment returning a validated bounded tool selection and prose grounds.",
  "bin": {
    "solicit-service": "./src/contract-editorial-assessment.mjs",
