{
  "name": "@emsenn/communicating-in-english",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Communicating in English — the English fiber over @emsenn/communicating: the compiled English bundle, English realization (generate/realizeClause/section), English prose conformance, and the runnable communicate/communicate-serve surface wired to English.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/scripts/*.mjs",
    "prepack": "pnpm run rebuild",
    "rebuild": "pnpm run clean && pnpm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "communicate": "./dist/scripts/communicate.mjs",
    "communicate-serve": "./dist/scripts/communicate-serve.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./bundle": {
      "types": "./dist/compiled.d.mts",
      "import": "./dist/compiled.mjs"
    },
    "./realizing": {
      "types": "./dist/realizing/index.d.mts",
      "import": "./dist/realizing/index.mjs"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.mts",
      "import": "./dist/conformance/index.mjs"
    },
    "./actions": {
      "types": "./dist/actions.d.mts",
      "import": "./dist/actions.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@emsenn/communicating": "workspace:*",
    "@emsenn/relating-experimental": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "sideEffects": false
}
