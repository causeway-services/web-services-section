{
  "name": "@emsenn/organizing-a-content-farm",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Organizing a content farm: a knowledge-vault specialization irrigated by newscables and cultivating producing-content farm outputs.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "rebuild": "npm run clean && npm run build",
    "verify": "npm run check && npm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "@emsenn/organizing-a-knowledge-vault": "workspace:*",
    "@emsenn/producing-content": "workspace:*",
    "@emsenn/relating": "workspace:*",
    "@sinclair/typebox": "^0.34.41"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false
}
