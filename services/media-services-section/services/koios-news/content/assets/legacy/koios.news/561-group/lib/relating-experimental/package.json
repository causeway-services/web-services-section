{
  "name": "@emsenn/relating-experimental",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Relating, greenfielded: one boundary system where every operation is an action (a cocone leg) projected to CLI/OpenAPI/MCP/web from a single dispatcher, every scripted invocation is witnessed as EAVT in the package's own ledger, and each object is data in an object.schema.json whose TypeScript type is the forgetful functor realize: Sub(J) → StructuralTypes.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.scripts.json && node copy-dist-assets.mjs && chmod +x dist/scripts/*.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "verify": "npm run check && npm run build",
    "prepack": "npm run rebuild",
    "rebuild": "npm run clean && npm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "relate": "./dist/scripts/cli.mjs",
    "relate-serve": "./dist/scripts/serve.mjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./articulating": {
      "types": "./dist/articulating/index.d.mts",
      "import": "./dist/articulating/index.mjs"
    },
    "./holography": {
      "types": "./dist/holography/index.d.mts",
      "import": "./dist/holography/index.mjs"
    },
    "./holography/projecting": {
      "types": "./dist/holography/projecting/index.d.mts",
      "import": "./dist/holography/projecting/index.mjs"
    },
    "./codecs": {
      "types": "./dist/codecs/index.d.mts",
      "import": "./dist/codecs/index.mjs"
    },
    "./acting": {
      "types": "./dist/acting/index.d.mts",
      "import": "./dist/acting/index.mjs"
    },
    "./typing": {
      "types": "./dist/typing/index.d.mts",
      "import": "./dist/typing/index.mjs"
    },
    "./package.json": "./package.json"
  }
}
