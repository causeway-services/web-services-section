{
  "name": "@emsenn/knowing",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "keywords": [
    "relational-computing",
    "relational-computing-kernel"
  ],
  "description": "Knowing - knowledge accumulation over the meme carrier of @emsenn/relating (a ≤_k comonad structure, not a definition): proof search, concept formation, memory/research carriers, and cognizing over the bilattice knowledge order. Concrete filepath memorystore admission lives downstream in @emsenn/organizing-a-knowledge-vault.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp && find src -name '*.schema.types.mts' -delete",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.scripts.json && node copy-dist-assets.mjs && chmod +x dist/scripts/*.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "verify": "npm run check && npm run build",
    "prepack": "npm run rebuild",
    "rebuild": "npm run clean && npm run build",
    "examples": "node examples/cognizing.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "know": "./dist/scripts/cli.mjs",
    "know-serve": "./dist/scripts/serve.mjs",
    "knowing": "./dist/scripts/knowing.mjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "@emsenn/relating": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./learning": {
      "types": "./dist/learning/index.d.mts",
      "import": "./dist/learning/index.mjs"
    },
    "./dreaming": {
      "types": "./dist/dreaming/index.d.mts",
      "import": "./dist/dreaming/index.mjs"
    },
    "./memory": {
      "types": "./dist/memory/index.d.mts",
      "import": "./dist/memory/index.mjs"
    },
    "./researching": {
      "types": "./dist/researching/index.d.mts",
      "import": "./dist/researching/index.mjs"
    },
    "./projecting": {
      "types": "./dist/projecting/index.d.mts",
      "import": "./dist/projecting/index.mjs"
    },
    "./package.json": "./package.json"
  }
}
