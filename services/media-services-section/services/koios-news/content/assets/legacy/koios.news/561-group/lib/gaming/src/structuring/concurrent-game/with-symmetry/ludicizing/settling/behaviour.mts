/**
 * Behaviours — bi-orthogonal closures of design-sets.
 *
 * Theorem (corpus, "behaviours are closure-rule-system commitments"): a
 * behaviour $\mathbf{B}$ at a locus is a bi-orthogonally closed set of designs,
 * $\mathbf{B} = \mathbf{B}^{\perp\perp}$, and corresponds to a closure-rule
 * system on the predication-fiber substrate; *formulas are the names of such
 * systems*.  The bi-orthogonal closure is a Galois closure on the lattice of
 * design-sets under the orthogonality relation $\perp$.
 *
 * Orthogonality quantifies over all designs; computationally we take the
 * closure relative to a finite *universe* of designs in play — the standard
 * presentation of $(-)^{\perp\perp}$ as a Galois closure on a chosen carrier.
 */
import { type Design } from "../../index.mjs";
import { orthogonal } from "./orthogonality.mjs";

const designKey = (d: Design): string => d.entries.map((e) => `${e.locusKey}:${e.charge.name}`).join("|");

const dedupe = (designs: readonly Design[]): readonly Design[] => {
  const seen = new Map<string, Design>();
  for (const d of designs) seen.set(designKey(d), d);
  return Object.freeze([...seen.values()]);
};

const inSet = (designs: readonly Design[], d: Design): boolean => {
  const key = designKey(d);
  return designs.some((other) => designKey(other) === key);
};

/**
 * $\mathbf{B}^\perp$ relative to a universe: the designs in the universe
 * orthogonal to *every* design in `set`.  The empty set's orthogonal is the
 * whole universe (vacuous quantification).
 */
export function orthogonalOf(set: readonly Design[], universe: readonly Design[]): readonly Design[] {
  return dedupe(universe.filter((candidate) => set.every((d) => orthogonal(d, candidate))));
}

/** $\mathbf{B}^{\perp\perp}$ relative to a universe — the bi-orthogonal (Galois) closure. */
export function biorthogonalClosure(set: readonly Design[], universe: readonly Design[]): readonly Design[] {
  return orthogonalOf(orthogonalOf(set, universe), universe);
}

export interface BehaviourWitness {
  readonly kind: "game.behaviour:witness";
  readonly carrier: readonly Design[];
}

export interface BehaviourObstruction {
  readonly kind: "game.behaviour-obstruction";
  readonly carrier: readonly Design[];
  readonly closure: readonly Design[];
  /** A design in the closure but not the carrier (or vice versa) witnessing non-closure. */
  readonly missing: Design | null;
}

export type BehaviourJudgment = BehaviourWitness | BehaviourObstruction;

/** Judge whether a set is a behaviour: closed under $(-)^{\perp\perp}$ within the universe. */
export function behaviourJudgment(set: readonly Design[], universe: readonly Design[]): BehaviourJudgment {
  const carrier = dedupe(set);
  const closure = biorthogonalClosure(carrier, universe);
  const missing = closure.find((d) => !inSet(carrier, d))
    ?? carrier.find((d) => !inSet(closure, d))
    ?? null;
  return missing === null
    ? Object.freeze({ kind: "game.behaviour:witness" as const, carrier })
    : Object.freeze({ kind: "game.behaviour-obstruction" as const, carrier, closure, missing });
}

export const isBehaviour = (set: readonly Design[], universe: readonly Design[]): boolean =>
  behaviourJudgment(set, universe).kind === "game.behaviour:witness";

/** Whether a design plays in the behaviour generated by `set` — i.e. lies in $\mathbf{B}^{\perp\perp}$. */
export function playsIn(d: Design, set: readonly Design[], universe: readonly Design[]): boolean {
  return inSet(biorthogonalClosure(set, universe), d);
}

/** The behaviour generated by a set: its bi-orthogonal closure, packaged as a carrier. */
export function generatedBehaviour(set: readonly Design[], universe: readonly Design[]): BehaviourWitness {
  return Object.freeze({ kind: "game.behaviour:witness" as const, carrier: biorthogonalClosure(set, universe) });
}
