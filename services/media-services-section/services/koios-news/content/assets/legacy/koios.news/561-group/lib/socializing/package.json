{
  "name": "@emsenn/socializing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "keywords": [
    "relational-computing",
    "relational-computing-kernel"
  ],
  "description": "Socializing — the society reading of agency: a Social Field carrier realizing the corpus's multi-observer system V: O → Settlings_B (members = observers; base = the observer category O whose morphisms are translation settling-morphisms; section = the consensus limit + H¹). Off-diagonal morphisms (admit, merge = CRDT ∨_k, translate = V(α), broadcast, attend, converge) carry the genuinely-social inter-observer structure; ten diagonal within-agent lifts add per-observer semiosis. converge delegates the H¹/CALM consensus law to the corpus's bilattice-network-sheaf consensus (sheafCharges).",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test \"test/*.test.mjs\"",
    "prepack": "pnpm run rebuild",
    "rebuild": "pnpm run clean && pnpm run build",
    "examples": "node examples/social-field.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./price": {
      "types": "./dist/socialize/price.d.mts",
      "import": "./dist/socialize/price.mjs"
    },
    "./currency": {
      "types": "./dist/socialize/currency.d.mts",
      "import": "./dist/socialize/currency.mjs"
    },
    "./institution": {
      "types": "./dist/socialize/institution.d.mts",
      "import": "./dist/socialize/institution.mjs"
    },
    "./mobilization": {
      "types": "./dist/socialize/mobilization.d.mts",
      "import": "./dist/socialize/mobilization.mjs"
    },
    "./publics": {
      "types": "./dist/socialize/publics.d.mts",
      "import": "./dist/socialize/publics.mjs"
    },
    "./anomie": {
      "types": "./dist/socialize/anomie.d.mts",
      "import": "./dist/socialize/anomie.mjs"
    },
    "./boundary": {
      "types": "./dist/socialize/boundary.d.mts",
      "import": "./dist/socialize/boundary.mjs"
    },
    "./legitimacy": {
      "types": "./dist/socialize/legitimacy.d.mts",
      "import": "./dist/socialize/legitimacy.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@emsenn/relating": "workspace:*",
    "@emsenn/communicating": "workspace:*",
    "@emsenn/animating": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "sideEffects": false
}
