{
  "name": "@emsenn/content",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Content — the domain of accountable content production, operationalized as one package. The former content-* and syndication-* libraries are now module subpaths: ./topology (the content-production algebra — demand, production, gates, copyedit, article, documentation, and the news subject core), ./codecs (frontmatter, ninjs, references, search-console, vault), ./markdown (CommonMark markdown → HTML/text encoder), ./image (PNG/JPEG/GIF/WebP container header codecs), ./syndication (syndication-format codecs + ./syndication/holography projection), and ./propaganda. Content is a configuration of the relationality apex.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/scripts/read.mjs dist/scripts/gate.mjs dist/scripts/rank.mjs",
    "prepack": "pnpm run rebuild",
    "rebuild": "pnpm run clean && pnpm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "content-read": "./dist/scripts/read.mjs",
    "content-gate": "./dist/scripts/gate.mjs",
    "content-rank": "./dist/scripts/rank.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./topology": {
      "types": "./dist/topology/index.d.mts",
      "import": "./dist/topology/index.mjs"
    },
    "./topology/news": {
      "types": "./dist/topology/news/index.d.mts",
      "import": "./dist/topology/news/index.mjs"
    },
    "./topology/demand": {
      "types": "./dist/topology/demand.d.mts",
      "import": "./dist/topology/demand.mjs"
    },
    "./topology/production": {
      "types": "./dist/topology/production.d.mts",
      "import": "./dist/topology/production.mjs"
    },
    "./topology/gates": {
      "types": "./dist/topology/gates.d.mts",
      "import": "./dist/topology/gates.mjs"
    },
    "./topology/copyedit": {
      "types": "./dist/topology/copyedit.d.mts",
      "import": "./dist/topology/copyedit.mjs"
    },
    "./topology/article": {
      "types": "./dist/topology/article.d.mts",
      "import": "./dist/topology/article.mjs"
    },
    "./topology/documentation": {
      "types": "./dist/topology/documentation.d.mts",
      "import": "./dist/topology/documentation.mjs"
    },
    "./codecs": {
      "types": "./dist/codecs/index.d.mts",
      "import": "./dist/codecs/index.mjs"
    },
    "./codecs/frontmatter": {
      "types": "./dist/codecs/frontmatter.d.mts",
      "import": "./dist/codecs/frontmatter.mjs"
    },
    "./codecs/ninjs": {
      "types": "./dist/codecs/ninjs.d.mts",
      "import": "./dist/codecs/ninjs.mjs"
    },
    "./codecs/jsonld": {
      "types": "./dist/codecs/jsonld.d.mts",
      "import": "./dist/codecs/jsonld.mjs"
    },
    "./codecs/feed": {
      "types": "./dist/codecs/feed.d.mts",
      "import": "./dist/codecs/feed.mjs"
    },
    "./codecs/microformats": {
      "types": "./dist/codecs/microformats.d.mts",
      "import": "./dist/codecs/microformats.mjs"
    },
    "./codecs/references": {
      "types": "./dist/codecs/references.d.mts",
      "import": "./dist/codecs/references.mjs"
    },
    "./codecs/relational": {
      "types": "./dist/codecs/relational.d.mts",
      "import": "./dist/codecs/relational.mjs"
    },
    "./codecs/search-console": {
      "types": "./dist/codecs/search-console.d.mts",
      "import": "./dist/codecs/search-console.mjs"
    },
    "./codecs/vault": {
      "types": "./dist/codecs/vault.d.mts",
      "import": "./dist/codecs/vault.mjs"
    },
    "./markdown": {
      "types": "./dist/markdown/index.d.mts",
      "import": "./dist/markdown/index.mjs"
    },
    "./image": {
      "types": "./dist/image/index.d.mts",
      "import": "./dist/image/index.mjs"
    },
    "./syndication": {
      "types": "./dist/syndication/index.d.mts",
      "import": "./dist/syndication/index.mjs"
    },
    "./syndication/holography": {
      "types": "./dist/syndication/holography.d.mts",
      "import": "./dist/syndication/holography.mjs"
    },
    "./propaganda": {
      "types": "./dist/propaganda/index.d.mts",
      "import": "./dist/propaganda/index.mjs"
    },
    "./propaganda/furtherance": {
      "types": "./dist/propaganda/furtherance.d.mts",
      "import": "./dist/propaganda/furtherance.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@emsenn/communicating-in-english": "workspace:*",
    "@emsenn/relating": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "sideEffects": false
}
