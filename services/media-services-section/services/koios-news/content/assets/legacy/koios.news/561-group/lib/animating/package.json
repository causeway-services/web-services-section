    },
    "./becoming/doing/working/governing/federating": {
      "types": "./dist/becoming/doing/working/governing/federating/index.d.mts",
      "import": "./dist/becoming/doing/working/governing/federating/index.mjs"
    },
    "./becoming/doing/working/governing/federating/assertion-worlds": {
