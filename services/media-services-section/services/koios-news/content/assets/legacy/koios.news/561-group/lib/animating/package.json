    },
    "./scripts": {
      "types": "./dist/scripts/api.d.mts",
      "import": "./dist/scripts/api.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@emsenn/content": "workspace:*",
    "@emsenn/communicating": "workspace:*",
    "@emsenn/relating": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "sideEffects": false
}
