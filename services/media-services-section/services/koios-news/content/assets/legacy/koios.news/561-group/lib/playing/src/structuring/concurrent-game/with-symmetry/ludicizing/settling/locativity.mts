/**
 * Locativity and the exponential connectives on behaviours.
 *
 * Two things live here, both resting on the delocation primitive of
 * `algebra/delocation.mjs`:
 *
 * 1. **Locativity** (Girard 2001, "Locus Solum": ludics is spatial). An
 *    interaction is invariant under relocating *both* dual designs by the same
 *    prefix — the play happens at whatever addresses the two designs share, and
 *    sliding both to a new address slides the meeting with them. So orthogonality
 *    is delocation-invariant: `D ⊥ E  ⟺  ξ·D ⊥ ξ·E`. This is the locative content
 *    that makes designs/behaviours *placeable* anywhere in the locus tree.
 *
 * 2. **The exponentials !B and ?B** (behaviour note, "Definition (Girard 2001
 *    §7)", exponentials), the step from MALL to full linear logic that the
 *    multiplicatives/additives of `internal-completeness.mjs` stop short of. The
 *    of-course `!B` collects the designs that supply *reusably many* copies of
 *    `B`; we realize it at a finite stage as the bi-orthogonal closure of the
 *    superpositions of `n` copies of `B`'s designs, each relocated under a disjoint
 *    sub-address `[0], … , [n-1]` (delocation is what keeps the copies from
 *    colliding). The true `!B` is the ω-colimit over the copy count `n` — named,
 *    not run, exactly as the `@emsenn/computing` !-comonad names its colimit. The
 *    why-not is the De Morgan dual `?B = (!(B⊥))⊥`.
 *
 * Nothing here reinvents the Galois closure or the join: of-course superposes via
 * `superpose` and closes via `generatedBehaviour`; why-not duals via `orthogonalOf`.
 */
import { type Design, type Locus, delocate, locus, superpose } from "../../index.mjs";
import { orthogonal } from "./orthogonality.mjs";
import { type BehaviourWitness, generatedBehaviour, isBehaviour, orthogonalOf } from "./behaviour.mjs";

const designKey = (d: Design): string => d.entries.map((e) => `${e.locusKey}:${e.charge.name}`).join("|");
const inSet = (designs: readonly Design[], d: Design): boolean => {
  const key = designKey(d);
  return designs.some((other) => designKey(other) === key);
};

export interface DelocationInvarianceWitness {
  readonly kind: "game.locativity.invariance:witness";
  readonly orthogonal: boolean;
  readonly prefix: Locus;
}
export interface DelocationInvarianceObstruction {
  readonly kind: "game.locativity.invariance-obstruction";
  readonly here: boolean;
  readonly delocated: boolean;
  readonly prefix: Locus;
}
export type DelocationInvarianceJudgment = DelocationInvarianceWitness | DelocationInvarianceObstruction;

/**
 * Witness locativity: relocating *both* dual designs by the same prefix preserves
 * orthogonality. `D ⊥ E` holds iff `(ξ·D) ⊥ (ξ·E)` — the meeting loci, and the
 * Daimon collision that decides convergence, slide along with the designs. The
 * obstruction (which never fires in this model) would record the two verdicts
 * disagreeing.
 */
export function delocationInvarianceJudgment(d1: Design, d2: Design, prefix: Locus): DelocationInvarianceJudgment {
  const here = orthogonal(d1, d2);
  const delocated = orthogonal(delocate(d1, prefix), delocate(d2, prefix));
  return here === delocated
    ? Object.freeze({ kind: "game.locativity.invariance:witness" as const, orthogonal: here, prefix })
    : Object.freeze({ kind: "game.locativity.invariance-obstruction" as const, here, delocated, prefix });
}

/** Whether orthogonality is preserved when both designs are delocated by a prefix. */
export const delocationInvariant = (d1: Design, d2: Design, prefix: Locus): boolean =>
  delocationInvarianceJudgment(d1, d2, prefix).kind === "game.locativity.invariance:witness";

/** Relocate an entire behaviour's carrier under a prefix locus — its designs, delocated. */
export function delocateBehaviour(carrier: readonly Design[], prefix: Locus): BehaviourWitness {
  return Object.freeze({
    kind: "game.behaviour:witness" as const,
    carrier: Object.freeze(carrier.map((d) => delocate(d, prefix))),
  });
}

/** The disjoint sub-address prefixes `[0], …, [copies-1]` the of-course relocates its copies under. */
const copyPrefixes = (copies: number): readonly Locus[] =>
  Object.freeze(Array.from({ length: copies }, (_, i) => locus([i])));

/** Every choice of one design of `b` per copy, each relocated under its copy's prefix and superposed. */
function copyTuples(b: readonly Design[], prefixes: readonly Locus[]): readonly Design[] {
  let tuples: Design[][] = [[]];
  for (const prefix of prefixes) {
    const next: Design[][] = [];
    for (const tuple of tuples) {
      for (const d of b) next.push([...tuple, delocate(d, prefix)]);
    }
    tuples = next;
  }
  return Object.freeze(tuples.map((tuple) => superpose(tuple)));
}

/**
 * The of-course `!B` at the `copies`-copy finite stage: the behaviour generated by
 * the superpositions of `copies` relocated copies of `B`'s designs. Each copy sits
 * under a disjoint sub-address so the copies stay independent; the result is closed
 * by `generatedBehaviour`. The true `!B` is the ω-colimit as `copies → ∞` — named,
 * not run. Keep `copies` and `|b|` small: the generator count is `|b|^copies`.
 */
export function ofCourseBehaviour(b: readonly Design[], copies: number, universe: readonly Design[]): BehaviourWitness {
  return generatedBehaviour(copyTuples(b, copyPrefixes(copies)), universe);
}

/**
 * The why-not `?B = (!(B⊥))⊥` at the `copies`-copy finite stage (behaviour note,
 * exponentials, De Morgan dual). Dual the behaviour, take its of-course, dual back.
 */
export function whyNotBehaviour(b: readonly Design[], copies: number, universe: readonly Design[]): BehaviourWitness {
  const dual = orthogonalOf(b, universe);
  const banged = ofCourseBehaviour(dual, copies, universe);
  return Object.freeze({
    kind: "game.behaviour:witness" as const,
    carrier: orthogonalOf(banged.carrier, universe),
  });
}

export interface ExponentialBehaviourWitness {
  readonly kind: "game.locativity.exponential:witness";
  readonly connective: "!" | "?";
  readonly carrier: readonly Design[];
}
export interface ExponentialBehaviourObstruction {
  readonly kind: "game.locativity.exponential-obstruction";
  readonly connective: "!" | "?";
  readonly carrier: readonly Design[];
}
export type ExponentialBehaviourJudgment = ExponentialBehaviourWitness | ExponentialBehaviourObstruction;

/**
 * Witness that an exponential construction produces a genuine behaviour — its
 * carrier is bi-orthogonally closed in the universe. Both `!B` and `?B` are
 * behaviours by construction (they end in a Galois closure); surfaced as a
 * judgment for uniformity with the other connective laws.
 */
export function exponentialBehaviourJudgment(connective: "!" | "?", carrier: readonly Design[], universe: readonly Design[]): ExponentialBehaviourJudgment {
  return isBehaviour(carrier, universe)
    ? Object.freeze({ kind: "game.locativity.exponential:witness" as const, connective, carrier })
    : Object.freeze({ kind: "game.locativity.exponential-obstruction" as const, connective, carrier });
}

export interface ExponentialMonotoneWitness {
  readonly kind: "game.locativity.monotone:witness";
}
export interface ExponentialMonotoneObstruction {
  readonly kind: "game.locativity.monotone-obstruction";
  /** A design of `!b1` not found in `!b2` — the monotonicity failure. */
  readonly escaping: Design;
}
export type ExponentialMonotoneJudgment = ExponentialMonotoneWitness | ExponentialMonotoneObstruction;

/**
 * Witness functoriality of the of-course: `b1 ⊆ b2 ⟹ !b1 ⊆ !b2`. Containment of
 * the generating design-sets carries through superposition and closure, so the
 * of-course is monotone — the behaviour-lattice shadow of `!` being a functor.
 */
export function ofCourseMonotoneJudgment(b1: readonly Design[], b2: readonly Design[], copies: number, universe: readonly Design[]): ExponentialMonotoneJudgment {
  const bang1 = ofCourseBehaviour(b1, copies, universe).carrier;
  const bang2 = ofCourseBehaviour(b2, copies, universe).carrier;
  const escaping = bang1.find((d) => !inSet(bang2, d)) ?? null;
  return escaping === null
    ? Object.freeze({ kind: "game.locativity.monotone:witness" as const })
    : Object.freeze({ kind: "game.locativity.monotone-obstruction" as const, escaping });
}
