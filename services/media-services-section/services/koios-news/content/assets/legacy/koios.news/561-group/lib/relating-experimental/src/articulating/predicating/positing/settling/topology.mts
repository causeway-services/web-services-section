/**
 * settling/topology — the composed relation descent.
 *
 * `induceRelation` is the whole descent with the same domain as `articulate`:
 * articulate → predicate → posit → settle. `relateRelations` relates two settled
 * relations by uttering their filtrations against each other and inducing — the
 * normalizing work IS the descent.
 */
import { articulate, mark, utterance, type UtteranceCarrier } from "../../../utterance.mjs";
import { predicate } from "../../predication.mjs";
import { posit } from "../fiber.mjs";
import { settle } from "./valuation-closure.mjs";
import type { SettlementFiltration } from "./object.mjs";

/** Induce the settlement filtration generated by one utterance carrier. */
export function induceRelation(carrier: UtteranceCarrier): SettlementFiltration {
  if (typeof carrier !== "object" || carrier === null || carrier.kind !== "utterance.carrier") {
    throw new TypeError("induceRelation: expected an utterance carrier");
  }
  return settle(posit(predicate(articulate(carrier))));
}

/** Relate two settled relations by uttering their filtrations against each other. */
export function relateRelations(left: SettlementFiltration, right: SettlementFiltration): SettlementFiltration {
  if (typeof left !== "object" || left === null || left.kind !== "predication.settlement.filtration") {
    throw new TypeError("relateRelations: expected left settlement filtration");
  }
  if (typeof right !== "object" || right === null || right.kind !== "predication.settlement.filtration") {
    throw new TypeError("relateRelations: expected right settlement filtration");
  }
  return induceRelation(utterance(mark(left), mark(right)));
}
