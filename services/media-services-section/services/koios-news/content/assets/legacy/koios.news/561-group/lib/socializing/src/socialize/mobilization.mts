/**
 * mobilization - coalition capacity priced as coordination currency.
 *
 * Resource-mobilization theory asks whether a collective has the usable resources and
 * organization needed to act. Formal concept analysis gives socializing a sharper carrier:
 * the mobilized bloc is the Galois-closed coalition generated by the seed agents, and its
 * mandate is the intent every member jointly holds. The priced costs are the gaps between
 * desire and capacity: missing mandate, closure drag, unstable relations, savior-slave
 * capture, and affective recuperation.
 *
 * The radical-autonomist reading matters here: a mobilization can be large and still be
 * captured if duty is separated from power, or if live contradiction is discharged as
 * managed mood. Those are not side notes; they mint the same h1-coordination-credit as
 * market and institutional disagreement.
 */
import {
  action,
  jsonResource,
  type Action,
  type JsonRecord,
  type JsonValue,
} from "@emsenn/relating";

import {
  coalitionConcept,
  holdingsOfRelations,
  type Coalition,
} from "./coalition.mjs";
import {
  saviorSlaveCensus,
  type SaviorSlaveCensus,
  type SaviorSlaveTrap,
} from "./clastre.mjs";
import { coordinationCurrency, type CoordinationCurrency, type CoordinationCurrencyCellInput } from "./currency.mjs";
import type { Governance, JuralRelation } from "./govern.mjs";
import {
  affectiveRecuperationIndex,
  type RecuperationIndex,
  type SettlingTrajectory,
} from "./recuperation.mjs";

export interface MobilizationInput {
  readonly name?: string;
  readonly relations?: readonly JuralRelation[];
  readonly governance?: Governance;
  readonly seed: readonly string[];
  readonly targetMandate?: readonly string[];
  readonly minimumCoalitionSize?: number;
  readonly trajectory?: SettlingTrajectory;
}

export interface Mobilization {
  readonly kind: "socializing.mobilization";
  readonly name: string;
  readonly seed: readonly string[];
  readonly targetMandate: readonly string[];
  readonly coalition: Coalition;
  readonly minimumCoalitionSize: number;
  readonly closureDrag: number;
  readonly scaleDeficit: number;
  readonly missingMandate: readonly string[];
  readonly contestedRelations: number;
  readonly saviorSlave: SaviorSlaveCensus;
  readonly coalitionTraps: readonly SaviorSlaveTrap[];
  readonly recuperation?: RecuperationIndex;
  readonly mobilized: boolean;
  readonly captured: boolean;
  readonly currency: CoordinationCurrency;
  readonly theory: JsonRecord;
}

const THEORY: JsonRecord = Object.freeze({
  resourceMobilization: "mobilization is usable coalition capacity, not only shared opinion",
  formalCoalition: "FCA closure reads the bloc and the mandate every member jointly holds",
  thresholdCollectiveAction: "minimumCoalitionSize prices the threshold gap before action can start",
  socialFactory: "closure drag is the distributed coordination labor hidden inside the field",
  antiCapture: "savior-slave traps price duty separated from power",
  recuperation: "discharged contradiction prices mobilization absorbed as managed consensus",
});

const isRecord = (value: unknown): value is JsonRecord =>
  typeof value === "object" && value !== null && !Array.isArray(value);

const uniqueSorted = (values: readonly string[]): readonly string[] =>
  Object.freeze([...new Set(values)].sort());

function relationsOf(input: MobilizationInput): readonly JuralRelation[] {
  if (input.relations !== undefined) return input.relations;
  if (input.governance !== undefined) return input.governance.relations;
  return Object.freeze([]);
}

function relationCapability(relation: JuralRelation): string {
  return `${relation.kind}:${relation.scope}`;
}

function relevantContestedRelations(
  relations: readonly JuralRelation[],
  coalitionAgents: readonly string[],
  targetMandate: readonly string[],
): number {
  const agents = new Set(coalitionAgents);
  const targets = new Set(targetMandate);
  return relations.filter((relation) => {
    if (relation.standing !== "stable") return false;
    if (!agents.has(relation.active) && !agents.has(relation.passive)) return false;
    return targets.size === 0 || targets.has(relationCapability(relation));
  }).length;
}

function trapsInCoalition(census: SaviorSlaveCensus, coalitionAgents: readonly string[], targetMandate: readonly string[]): readonly SaviorSlaveTrap[] {
  const agents = new Set(coalitionAgents);
  const targetScopes = new Set(targetMandate.map((capability) => capability.slice(capability.indexOf(":") + 1)));
  return Object.freeze(census.traps.filter((trap) =>
    agents.has(trap.agent) && (targetScopes.size === 0 || targetScopes.has(trap.scope))));
}

function mobilizationCells(input: {
  readonly name: string;
  readonly closureDrag: number;
  readonly scaleDeficit: number;
  readonly missingMandate: readonly string[];
  readonly contestedRelations: number;
  readonly coalitionTraps: readonly SaviorSlaveTrap[];
  readonly recuperation?: RecuperationIndex;
}): readonly CoordinationCurrencyCellInput[] {
  const recuperativeDischarge = input.recuperation?.discharged ?? 0;
  return Object.freeze([
    Object.freeze({
      id: `mobilization:${input.name}:closure-drag`,
      source: "mobilize",
      spreadH1: input.closureDrag,
      noArbitrage: input.closureDrag === 0,
      coherentConsensus: input.closureDrag === 0,
    }),
    Object.freeze({
      id: `mobilization:${input.name}:scale-threshold`,
      source: "mobilize",
      spreadH1: input.scaleDeficit,
      noArbitrage: input.scaleDeficit === 0,
      coherentConsensus: input.scaleDeficit === 0,
    }),
    Object.freeze({
      id: `mobilization:${input.name}:mandate-gap`,
      source: "mobilize",
      spreadH1: input.missingMandate.length,
      noArbitrage: input.missingMandate.length === 0,
      coherentConsensus: input.missingMandate.length === 0,
    }),
    Object.freeze({
      id: `mobilization:${input.name}:contested-relations`,
      source: "mobilize",
      spreadH1: input.contestedRelations,
      noArbitrage: input.contestedRelations === 0,
      coherentConsensus: input.contestedRelations === 0,
    }),
    Object.freeze({
      id: `mobilization:${input.name}:savior-slave-capture`,
      source: "mobilize",
      spreadH1: input.coalitionTraps.length,
      noArbitrage: input.coalitionTraps.length === 0,
      coherentConsensus: input.coalitionTraps.length === 0,
    }),
    Object.freeze({
      id: `mobilization:${input.name}:recuperation`,
      source: "mobilize",
      spreadH1: recuperativeDischarge,
      noArbitrage: recuperativeDischarge === 0,
      coherentConsensus: recuperativeDischarge === 0,
    }),
  ]);
}

export function mobilize(input: MobilizationInput): Mobilization {
  const name = input.name ?? "mobilization";
  const seed = uniqueSorted(input.seed);
  const targetMandate = uniqueSorted(input.targetMandate ?? []);
  const minimumCoalitionSize = input.minimumCoalitionSize ?? Math.max(1, seed.length);
  if (!Number.isInteger(minimumCoalitionSize) || minimumCoalitionSize < 0) {
    throw new TypeError("mobilize: minimumCoalitionSize must be a nonnegative integer");
  }

  const relations = relationsOf(input);
  const coalition = coalitionConcept(holdingsOfRelations(relations), seed);
  const closureDrag = Math.max(0, coalition.agents.length - seed.length);
  const scaleDeficit = Math.max(0, minimumCoalitionSize - coalition.agents.length);
  const mandate = new Set(coalition.mandate);
  const missingMandate = Object.freeze(targetMandate.filter((capability) => !mandate.has(capability)));
  const contestedRelations = relevantContestedRelations(relations, coalition.agents, targetMandate);
  const saviorSlave = saviorSlaveCensus(relations);
  const coalitionTraps = trapsInCoalition(saviorSlave, coalition.agents, targetMandate);
  const recuperation = input.trajectory === undefined ? undefined : affectiveRecuperationIndex(input.trajectory);
  const captured = coalitionTraps.length > 0 || recuperation?.recuperated === true;
  const currency = coordinationCurrency(mobilizationCells({
    name,
    closureDrag,
    scaleDeficit,
    missingMandate,
    contestedRelations,
    coalitionTraps,
    ...(recuperation === undefined ? {} : { recuperation }),
  }));
  return Object.freeze({
    kind: "socializing.mobilization" as const,
    name,
    seed,
    targetMandate,
    coalition,
    minimumCoalitionSize,
    closureDrag,
    scaleDeficit,
    missingMandate,
    contestedRelations,
    saviorSlave,
    coalitionTraps,
    ...(recuperation === undefined ? {} : { recuperation }),
    mobilized: currency.issued === 0 && coalition.agents.length >= minimumCoalitionSize && !captured,
    captured,
    currency,
    theory: THEORY,
  });
}

function readStringArray(value: unknown, label: string): readonly string[] {
  if (!Array.isArray(value) || !value.every((item) => typeof item === "string")) {
    throw new TypeError(`mobilize: expected ${label} as string[]`);
  }
  return Object.freeze([...value]);
}

function admitMobilizationInput(value: JsonValue): MobilizationInput {
  if (!isRecord(value)) throw new TypeError("mobilize: expected an object input");
  const relations = Array.isArray(value.relations)
    ? value.relations as unknown as readonly JuralRelation[]
    : undefined;
  const governance = isRecord(value.governance) && Array.isArray(value.governance.relations)
    ? value.governance as unknown as Governance
    : undefined;
  if (relations === undefined && governance === undefined) {
    throw new TypeError("mobilize: expected relations or governance");
  }
  const input: {
    name?: string;
    relations?: readonly JuralRelation[];
    governance?: Governance;
    seed: readonly string[];
    targetMandate?: readonly string[];
    minimumCoalitionSize?: number;
    trajectory?: SettlingTrajectory;
  } = {
    seed: readStringArray(value.seed, "seed"),
  };
  if (typeof value.name === "string") input.name = value.name;
  if (relations !== undefined) input.relations = relations;
  if (governance !== undefined) input.governance = governance;
  if (value.targetMandate !== undefined) input.targetMandate = readStringArray(value.targetMandate, "targetMandate");
  if (typeof value.minimumCoalitionSize === "number") input.minimumCoalitionSize = value.minimumCoalitionSize;
  if (isRecord(value.trajectory) && Array.isArray(value.trajectory.stages)) {
    input.trajectory = value.trajectory as unknown as SettlingTrajectory;
  }
  return Object.freeze(input);
}

const MOBILIZATION_SCHEMA: JsonRecord = Object.freeze({
  title: "Mobilization",
  type: "object",
  description:
    "FCA coalition mobilization priced through coordination-currency: closure drag, threshold gap, missing mandate, contested relations, savior-slave capture, and recuperative discharge.",
});

export const mobilizeAction: Action = action({
  verb: "mobilize",
  inputFormat: "json",
  outputFormat: "json",
  summary: "Read whether seed agents can mobilize a coalition and price the unresolved coordination work.",
  description:
    "Composes coalitionConcept, saviorSlaveCensus, and optional affectiveRecuperationIndex. Missing mandate, scale threshold, closure drag, contested jural cells, duty-without-power capture, and recuperative discharge emit h1-coordination-credit cells.",
  domainSchema: Object.freeze({ type: "object" }),
  codomainSchema: MOBILIZATION_SCHEMA,
  run: (input: unknown): JsonValue =>
    jsonResource(mobilize(admitMobilizationInput(jsonResource(input, "mobilize input"))) as unknown as JsonValue, "mobilization"),
});

export const mobilizationActions: readonly Action[] = Object.freeze([
  mobilizeAction,
]);
