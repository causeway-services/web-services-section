{
  "name": "@emsenn/communicating",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Communicating — speech and listening admitted through @emsenn/relating: boundary documents normalize to Mark/Utterance carriers, then derive linguistic carriers, readings, codecs, conformance, and per-language bundle surfaces.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run rebuild",
    "rebuild": "pnpm run clean && pnpm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./holography": {
      "types": "./dist/holography/index.d.mts",
      "import": "./dist/holography/index.mjs"
    },
    "./speaking/listening/algebra": {
      "types": "./dist/speaking/listening/algebra/index.d.mts",
      "import": "./dist/speaking/listening/algebra/index.mjs"
    },
    "./speaking/listening/understanding": {
      "types": "./dist/speaking/listening/understanding/index.d.mts",
      "import": "./dist/speaking/listening/understanding/index.mjs"
    },
    "./speaking/listening/codecs": {
      "types": "./dist/speaking/listening/codecs/index.d.mts",
      "import": "./dist/speaking/listening/codecs/index.mjs"
    },
    "./speaking/listening/geometry": {
      "types": "./dist/speaking/listening/geometry/index.d.mts",
      "import": "./dist/speaking/listening/geometry/index.mjs"
    },
    "./speaking/listening/judging/grammaticality": {
      "types": "./dist/speaking/listening/judging/grammaticality/index.d.mts",
      "import": "./dist/speaking/listening/judging/grammaticality/index.mjs"
    },
    "./speaking/listening/parsing": {
      "types": "./dist/speaking/listening/parsing/index.d.mts",
      "import": "./dist/speaking/listening/parsing/index.mjs"
    },
    "./speaking/listening/grounding": {
      "types": "./dist/speaking/listening/grounding/index.d.mts",
      "import": "./dist/speaking/listening/grounding/index.mjs"
    },
    "./speaking": {
      "types": "./dist/speaking/index.d.mts",
      "import": "./dist/speaking/index.mjs"
    },
    "./speaking/signifying": {
      "types": "./dist/speaking/signifying/index.d.mts",
      "import": "./dist/speaking/signifying/index.mjs"
    },
    "./speaking/illocuting": {
      "types": "./dist/speaking/illocuting/index.d.mts",
      "import": "./dist/speaking/illocuting/index.mjs"
    },
    "./speaking/listening": {
      "types": "./dist/speaking/listening/index.d.mts",
      "import": "./dist/speaking/listening/index.mjs"
    },
    "./messaging": {
      "types": "./dist/messaging/index.d.mts",
      "import": "./dist/messaging/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@emsenn/relating-experimental": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "sideEffects": false
}
