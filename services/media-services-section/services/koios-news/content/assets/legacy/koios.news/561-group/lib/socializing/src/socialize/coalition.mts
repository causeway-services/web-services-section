/**
 * coalition — socializing's COALITION STRUCTURE via Formal Concept Analysis. A question the field
 * usually answers ad hoc (which subsets of agents are the "real" coalitions?) gets an exact answer
 * here: the natural coalitions of a polity are the FORMAL CONCEPTS of its agent × capability
 * incidence, and they form a COMPLETE LATTICE — the Galois-closed coalition lattice.
 *
 * The construction (Wille's FCA, here grounded in relating's `fca` operators / RelMath.FCA, proven in
 * Lean): an agent HOLDS a capability (a power/duty/privilege/immunity over some scope). This incidence
 * I(agent, capability) induces a Galois connection — intentOfExtent (the capabilities EVERY agent in a
 * set shares) ⊣ extentOfIntent (every agent holding ALL of a capability set). Its closure
 * closeExtent = primeB∘primeA sends a seed set of agents to the smallest CLOSED coalition containing
 * it: the agents who are indistinguishable by shared mandate. A formal concept (extent, intent) is a
 * coalition together with exactly the mandate its members jointly hold — a maximal cohesive bloc, not
 * an arbitrary subset. The fundamental theorem of FCA (Lean-proved) makes these concepts a complete
 * lattice under extent inclusion: meets are mandate-unions, joins are agent-unions-then-closed.
 *
 * This is the categorical skeleton beneath the kyriarchy/coalition story in `govern.mts`: a dominator
 * is the apex object-concept; a swarm is a flat anti-chain of incomparable concepts. It consumes
 * relating's FCA IR terms via `evaluateRunTerm`; it re-derives no Galois math.
 */
import { evaluateRunTerm, fca, type JsonValue } from "@emsenn/relating";

import type { JuralRelation } from "./govern.mjs";

/** An agent holding a capability — the incidence I(agent, capability) FCA reads as a (subject,
 *  predicate) cell. A capability is a held jural position keyed `${kind}:${scope}`. */
export interface CapabilityHolding {
  readonly agent: string;
  readonly capability: string;
}

/** A natural coalition: a formal concept of the agent × capability incidence — a maximal bloc of
 *  agents (the extent) together with exactly the mandate they jointly hold (the intent). */
export interface Coalition {
  readonly kind: "socializing.coalition";
  /** the agents in the coalition (the closed extent). */
  readonly agents: readonly string[];
  /** the capabilities EVERY member jointly holds (the intent) — the coalition's shared mandate. */
  readonly mandate: readonly string[];
}

/** Read capability holdings off a society's jural relations: a held (not denied) relation means its
 *  active holder bears the capability `${kind}:${scope}`. Bridges `govern.mts` into the coalition lattice. */
export function holdingsOfRelations(relations: readonly JuralRelation[]): readonly CapabilityHolding[] {
  return Object.freeze(
    relations
      .filter((relation) => relation.standing === "potential" || relation.standing === "stable")
      .map((relation) => Object.freeze({ agent: relation.active, capability: `${relation.kind}:${relation.scope}` })),
  );
}

const cellsOf = (holdings: readonly CapabilityHolding[]): JsonValue =>
  holdings.map((holding) => ({ subject: holding.agent, predicate: holding.capability })) as unknown as JsonValue;

const agentsOf = (holdings: readonly CapabilityHolding[]): readonly string[] =>
  [...new Set(holdings.map((holding) => holding.agent))];

/** The FCA closure of a seed set of agents — the smallest CLOSED coalition containing it (the agents
 *  the seed cannot be told apart from by shared mandate). `closeExtent` = primeB∘primeA from RelMath.FCA. */
export function coalitionClosure(holdings: readonly CapabilityHolding[], seed: readonly string[]): readonly string[] {
  const closed = evaluateRunTerm(fca.closeExtent, { cells: cellsOf(holdings), extent: [...seed] } as unknown as JsonValue);
  return Object.freeze((closed as unknown as string[]) ?? []);
}

/** The formal concept generated by a seed set of agents: the closed coalition + its shared mandate. */
export function coalitionConcept(holdings: readonly CapabilityHolding[], seed: readonly string[]): Coalition {
  const concept = evaluateRunTerm(fca.formalConcept, { cells: cellsOf(holdings), extent: [...seed] } as unknown as JsonValue) as unknown as {
    extent: readonly string[];
    intent: readonly string[];
  };
  return Object.freeze({
    kind: "socializing.coalition" as const,
    agents: Object.freeze([...(concept.extent ?? [])].sort()),
    mandate: Object.freeze([...(concept.intent ?? [])].sort()),
  });
}

/** Whether (agents, mandate) is a genuine formal concept — closed on both sides (no agent or
 *  capability can be added without changing the other). */
export function isCoalition(holdings: readonly CapabilityHolding[], agents: readonly string[], mandate: readonly string[]): boolean {
  return evaluateRunTerm(fca.isConceptPair, {
    cells: cellsOf(holdings),
    extent: [...agents],
    intent: [...mandate],
  } as unknown as JsonValue) as unknown as boolean;
}

const extentKey = (agents: readonly string[]): string => JSON.stringify([...agents].sort());

/**
 * coalitionLattice — the complete lattice of a polity's natural coalitions: every formal concept of
 * the agent × capability incidence. Generated from the OBJECT CONCEPTS γ(agent) = the concept of each
 * single agent's closure, the TOP concept (all agents, with their universally-shared mandate), and the
 * meet-closure under extent intersection (the intersection of closed extents is closed — FCA's
 * fundamental theorem). Returned sorted by decreasing coalition size (the apex/most-inclusive concepts
 * first). Bounded to ≤ 14 agents (the lattice can be exponential).
 */
export function coalitionLattice(holdings: readonly CapabilityHolding[]): readonly Coalition[] {
  const agents = agentsOf(holdings);
  if (agents.length > 14) throw new RangeError("coalitionLattice: at most 14 agents (the concept lattice can be exponential)");

  const concepts = new Map<string, Coalition>();
  const register = (concept: Coalition): void => { concepts.set(extentKey(concept.agents), concept); };

  // the top concept (all agents and the mandate they all share) and every object concept.
  register(coalitionConcept(holdings, agents));
  for (const agent of agents) register(coalitionConcept(holdings, [agent]));

  // close under MEET: the intersection of two closed extents is itself a closed extent (a concept).
  let frontier = [...concepts.values()];
  while (frontier.length > 0) {
    const next: Coalition[] = [];
    for (const left of frontier) {
      for (const right of concepts.values()) {
        const rightSet = new Set(right.agents);
        const meetAgents = left.agents.filter((agent) => rightSet.has(agent));
        const key = extentKey(meetAgents);
        if (concepts.has(key)) continue;
        const concept = coalitionConcept(holdings, meetAgents);
        if (!concepts.has(extentKey(concept.agents))) {
          register(concept);
          next.push(concept);
        }
      }
    }
    frontier = next;
  }

  return Object.freeze([...concepts.values()].sort((a, b) => b.agents.length - a.agents.length || extentKey(a.agents).localeCompare(extentKey(b.agents))));
}
